# Compose's settings for the production stack: copy to `.env` beside
# compose.yml, chmod 0600, and replace every <...> value.

# Required. The image app, egress, and web run: sha- and the full commit
# sha, as the package's tags list them; update.sh moves it.
HEXO_ARENA_IMAGE=ghcr.io/<owner>/hexo-arena:sha-<full commit sha>
# Required. The domain Caddy serves and fetches a certificate for; the
# host of PUBLIC_ORIGIN and of the Discord redirect.
HEXO_ARENA_DOMAIN=<domain>
