# TLS, proxying, and the browser's security headers.
# Rate limits live in the app, egress control in the network, and nothing
# here compresses or buffers the API.
# The app's rate limits read the client address this proxy forwards,
# keyed and hashed in memory, never logged.
# No access log, so no client address is stored.
{
	servers {
		# A connection that never finishes its headers holds memory until
		# the container's cap; ten seconds bounds each.
		# No body or write timeout: either would cut bot streams and live
		# game events.
		timeouts {
			read_header 10s
		}
	}
}

# The site runs no inline script or style and loads nothing from
# elsewhere, so the policy allows its own origin alone.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

{$HEXO_ARENA_DOMAIN} {
	import security_headers

	handle /api/* {
		# Tokens and account data ride these answers; nothing may cache
		# one the app left unmarked.
		header ?Cache-Control "no-store"
		# Flush every write at once: a buffered NDJSON line is a bot that
		# looks offline.
		# Websocket upgrades pass through as is.
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy app:3000
	}

	# The deployment's legal documents and the details they fill in, as
	# files from its legal folder; every other path under /legal/ is a page.
	# Revalidated on each load, so an edit shows at once.
	@legalFile path /legal/imprint.md /legal/privacy.md /legal/terms.md /legal/details.json
	handle @legalFile {
		root * /srv
		header Cache-Control no-cache
		encode zstd gzip
		file_server
	}

	# Every page of the site gets its shell from the app, with og meta from
	# live data and an absolute preview image.
	@shell path / /play /ladder /bots/* /players/* /game/* /tournaments/* /bots /games /games/live /tournaments /connect /profile /credits /report /welcome /legal/imprint /legal/privacy /legal/terms
	handle @shell {
		reverse_proxy app:3000 {
			# An app that fails a page still leaves it the static shell;
			# handle_errors below sees only the proxy's own failures.
			@appFailed status 500
			handle_response @appFailed {
				root * /srv/web
				rewrite * /index.html
				file_server
			}
		}
	}

	# An app that is down or restarting still leaves these routes the
	# static shell, so the site stays usable through a deploy.
	handle_errors 500 502 503 504 {
		# An error answer starts without the headers set above.
		import security_headers
		@shellDown path / /play /ladder /bots/* /players/* /game/* /tournaments/* /bots /games /games/live /tournaments /connect /profile /credits /report /welcome /legal/imprint /legal/privacy /legal/terms
		handle @shellDown {
			root * /srv/web
			rewrite * /index.html
			file_server
		}
	}

	handle {
		root * /srv/web
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
