# TLS and proxying only.
# Rate limits live in the app, egress control in the network, and nothing
# here compresses or buffers the API.
# The app's rate limits read the client address this proxy forwards,
# keyed and hashed in memory, never logged.
# No access log, so no client address is stored.

{$HEXO_ARENA_DOMAIN} {
	handle /api/* {
		# Flush every write at once: a buffered NDJSON line is a bot that
		# looks offline.
		# Websocket upgrades pass through as is.
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy app:3000
	}

	# Every page of the site gets its shell from the app, with og meta from
	# live data and an absolute preview image.
	@shell path / /play /ladder /bots/* /game/* /bots /games /games/live /connect /profile /credits /welcome /legal/imprint /legal/privacy /legal/terms
	handle @shell {
		reverse_proxy app:3000
	}

	# An app that is down or restarting still leaves these routes the
	# static shell, so the site stays usable through a deploy.
	handle_errors 502 503 504 {
		@shellDown path / /play /ladder /bots/* /game/* /bots /games /games/live /connect /profile /credits /welcome /legal/imprint /legal/privacy /legal/terms
		handle @shellDown {
			root * /srv/web
			rewrite * /index.html
			file_server
		}

		# The legal pages name the operator from the details read, so the
		# file the app reads answers it in the app's place; an error route
		# writes the error's status unless told otherwise.
		@legalDown path /api/legal
		handle @legalDown {
			root * /etc/hexo-arena
			rewrite * /legal-details.json
			file_server {
				status 200
			}
		}
	}

	handle {
		root * /srv/web
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
