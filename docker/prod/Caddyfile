# TLS and proxying only.
# Rate limits live in the app, egress control in the network, and nothing
# here compresses or buffers the API.
# The app's rate limits read the client address this proxy forwards,
# keyed and hashed in memory, never logged.
# No access log, so no client address is stored.

{$HEXO_ARENA_DOMAIN} {
	handle /api/* {
		# Flush every write at once: a buffered NDJSON line is a bot that
		# looks offline.
		# Websocket upgrades pass through as is.
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy app:3000
	}

	# The deployment's legal documents and the details they fill in, as
	# files from its legal folder; every other path under /legal/ is a page.
	# Revalidated on each load, so an edit shows at once.
	@legalFile path /legal/imprint.md /legal/privacy.md /legal/terms.md /legal/details.json
	handle @legalFile {
		root * /srv
		header Cache-Control no-cache
		encode zstd gzip
		file_server
	}

	# Every page of the site gets its shell from the app, with og meta from
	# live data and an absolute preview image.
	@shell path / /play /ladder /bots/* /players/* /game/* /tournaments/* /bots /games /games/live /tournaments /connect /profile /credits /welcome /legal/imprint /legal/privacy /legal/terms
	handle @shell {
		reverse_proxy app:3000
	}

	# An app that is down or restarting still leaves these routes the
	# static shell, so the site stays usable through a deploy.
	handle_errors 502 503 504 {
		@shellDown path / /play /ladder /bots/* /players/* /game/* /tournaments/* /bots /games /games/live /tournaments /connect /profile /credits /welcome /legal/imprint /legal/privacy /legal/terms
		handle @shellDown {
			root * /srv/web
			rewrite * /index.html
			file_server
		}
	}

	handle {
		root * /srv/web
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
