# The app's settings and secrets for the production stack: copy to
# `hexo-arena.env` beside compose.yml, chmod 0600, and replace every <...>
# value.
# The image and the compose file set every other variable; leave them out.

# Required. The site's address: https, the domain in .env, no path.
PUBLIC_ORIGIN=https://<domain>
# Required. The Discord application's OAuth2 client ID and secret; empty
# turns sign-in off.
DISCORD_CLIENT_ID=<client id>
DISCORD_CLIENT_SECRET=<client secret>

# Optional; these are the defaults.
# The name audit rows give the operator.
ADMIN_ACTOR=operator
# How many nightly backups to keep; the privacy policy states 14.
BACKUP_KEEP=14
# The UTC hour of the nightly backup and purge.
BACKUP_HOUR_UTC=3
# on takes reports through the site's form; empty leaves it off, and the
# legal texts send notices to the operator's email alone.
REPORT_FORM=
