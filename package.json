{
    "name": "hexo-arena",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "pnpm -r --parallel --if-present dev",
        "dev:compose": "docker compose up --build",
        "dev:bots": "pnpm --filter @hexo-arena/dev-bots start",
        "dev:seed": "pnpm --filter @hexo-arena/dev-bots seed",
        "build": "pnpm -r --if-present build",
        "test": "node --test scripts/*.test.mjs && pnpm -r --no-bail --if-present test",
        "e2e": "pnpm --filter @hexo-arena/web e2e",
        "e2e:build": "E2E_BUILD=1 pnpm --filter @hexo-arena/web e2e",
        "e2e:ci": "E2E_BUILD=1 pnpm --filter @hexo-arena/web e2e --grep-invert @sweep",
        "typecheck": "pnpm -r --if-present typecheck",
        "lint": "eslint .",
        "check": "pnpm typecheck && pnpm lint && node scripts/check-planning-refs.mjs && node scripts/check-ascii.mjs && node scripts/check-ui-literals.mjs && node scripts/check-ui-text.mjs && node scripts/check-contrast.mjs",
        "openapi": "pnpm --filter @hexo-arena/contract generate",
        "spec:export": "pnpm --filter @hexo-arena/contract spec:export"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "eslint-plugin-tsdoc": "^0.5.4",
        "typescript-eslint": "^8.71.0"
    }
}
