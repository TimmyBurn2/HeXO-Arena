# Server settings for a local `pnpm dev`: copy this file to .env, which
# stays untracked. Variables already set in the shell win over the file.
# Relative paths resolve from apps/server, where the server runs.
# Production does not read this file; DEPLOY.md describes its env files.

# Address the API binds; the Vite dev server proxies /api to it.
HOST=127.0.0.1
# Port the API listens on.
PORT=3000
# The SQLite database file.
DATABASE_PATH=data/hexo-arena.sqlite
# The site origin: builds the Discord redirect uri, and http leaves the session cookie without Secure.
PUBLIC_ORIGIN=http://localhost:3000
# Discord OAuth client id; empty turns Discord login off, and the auth routes answer 503.
DISCORD_CLIENT_ID=
# Discord OAuth client secret; empty turns Discord login off as well.
DISCORD_CLIENT_SECRET=
# Empty in development; the production image sets it, and then any DEV_LOGIN value refuses the boot.
NODE_ENV=
# 1 registers the dev routes: POST /api/dev/login, which signs in any name without Discord, and GET /api/dev/accounts.
DEV_LOGIN=1
# 1 makes SIGTERM stop at once instead of draining, so tsx watch restarts never wait on a live game.
DEV_FAST_STOP=1
# The admin socket; its directory must be mode 0700 and owned by you.
ADMIN_SOCKET_PATH=data/run/admin.sock
# The name stamped on admin audit rows.
ADMIN_ACTOR=operator
# The built index.html for the og shell routes; empty leaves them off, since Vite serves the page.
WEB_INDEX_PATH=
# The operator's legal details as JSON; the example's placeholders pass here, and production refuses them.
LEGAL_DETAILS_PATH=legal-details.example.json
# Where nightly backups land; empty takes none.
BACKUP_DIR=
# How many nightly backups to keep.
BACKUP_KEEP=14
# The UTC hour the nightly backup runs.
BACKUP_HOUR_UTC=3
# The proxy's address, whose forwarded client address the rate limits key by; empty trusts none, and production requires it.
TRUSTED_PROXY=
